{
  "name": "osm-lanes",
  "version": "0.1.0",
  "description": "Interpret OpenStreetMap lane tags (lanes, turn:lanes, access:lanes, destination:lanes, …) of a way and render them as SVG.",
  "keywords": ["openstreetmap", "osm", "lanes", "turn:lanes", "destination:lanes", "overpass", "svg", "road", "traffic"],
  "license": "Apache-2.0",
  "author": "Graphmasters",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Graphmasters/osm-lanes.git"
  },
  "homepage": "https://graphmasters.github.io/osm-lanes/",
  "bugs": "https://github.com/Graphmasters/osm-lanes/issues",
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "NOTICE", "ATTRIBUTION.md"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.global.js",
  "jsdelivr": "./dist/index.global.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "build:app": "vite build",
    "dev": "vite",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "assets": "node scripts/build-assets.mjs",
    "fetch-stvo": "node scripts/fetch-stvo.mjs",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@waysidemapping/pinhead": "~16.26.0",
    "maplibre-gl": "~6.17.0",
    "tsup": "~8.5.1",
    "typescript": "~5.9.3",
    "vite": "~7.3.7",
    "vitest": "~3.2.7"
  }
}
